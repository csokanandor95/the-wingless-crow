{
  "name": "the-wingless-crow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:integration": "vitest run tests/integration",
    "check:build": "node scripts/check-build.mjs",
    "e2e": "npm run build && playwright test --project=chromium --project=firefox",
    "e2e:smoke": "npm run build && playwright test smoke --project=chromium --project=firefox",
    "e2e:report": "playwright show-report",
    "e2e:perf": "npm run build && playwright test --project=performance --workers=1",
    "e2e:visual": "npm run build && playwright test visual --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
